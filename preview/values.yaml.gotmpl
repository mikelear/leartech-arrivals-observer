image:
  repository: "{{ requiredEnv "DOCKER_REGISTRY" }}/{{ requiredEnv "DOCKER_REGISTRY_ORG" }}/{{ requiredEnv "APP_NAME" }}"
  tag: "{{ requiredEnv "VERSION" }}"

replicaCount: 1

# Skip CRD install in preview — the cluster's canonical release in
# jx-staging already installed the cluster-scoped Arrival CRD; helm
# can't re-import it into the preview release without ownership
# conflict. Preview reuses the cluster's existing CRD.
crd:
  install: false

# jxRequirements override for preview
jxRequirements:
  ingress:
    namespaceSubDomain: "-pr{{ requiredEnv "PULL_NUMBER" }}."

config:
  cluster: '{{ env "CLUSTER_ID" | default "" }}'
  logLevel: debug

# Looser resources for previews
resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    memory: 256Mi
